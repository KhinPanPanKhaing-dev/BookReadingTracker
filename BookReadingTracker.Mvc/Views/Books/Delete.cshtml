@model BookReadingTracker.Domain.DTOs.BookDto

<h1>Delete Book</h1>
<p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
<dl class="row">
    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">Pages</dt>
    <dd class="col-sm-10">@Model.TotalPages</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
