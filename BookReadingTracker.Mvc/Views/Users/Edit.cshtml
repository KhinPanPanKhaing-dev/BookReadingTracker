@model BookReadingTracker.Domain.DTOs.UserDto

<h1>Edit User</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.UserId" />
    <div class="mb-3">
        <label class="form-label">User Name</label>
        <input name="userName" value="@Model.UserName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" value="@Model.Email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">New Password (leave blank to keep current)</label>
        <input name="password" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select name="roleName" class="form-control">
            <option value="User" selected="@(Model.RoleName == "User")">User</option>
            <option value="Admin" selected="@(Model.RoleName == "Admin")">Admin</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
